{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node10",
    "resolvePackageJsonExports": false
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    "prisma.config.ts",
    "prisma.mysql.config.ts",
    "generated/**"
  ]
}